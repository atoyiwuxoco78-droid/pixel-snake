rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-difficulty boards — only orderBy(score) needed (auto index)
    match /boards/{difficulty}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && difficulty in ['easy', 'normal', 'hell']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.difficulty == difficulty
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Weekly season boards: seasons/{seasonId}/boards/{difficulty}/entries/{uid}
    match /seasons/{seasonId}/boards/{difficulty}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && difficulty in ['easy', 'normal', 'hell']
        && seasonId.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.difficulty == difficulty
        && request.resource.data.seasonId == seasonId
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy scores/{docId} — keep readable; allow own writes for old clients
    match /scores/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /mp_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && roomId.matches('[A-Z0-9]{6}');
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid
        || resource.data.guestUid == request.auth.uid
        || (
          resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
        )
      );
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
