rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{userId} {
      // Public read for leaderboard
      allow read: if true;
      // Logged-in users may write only their own doc; score must not go down
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && (!resource.exists || request.resource.data.score >= resource.data.score);
      allow delete: if false;
    }
  }
}
