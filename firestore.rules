rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{docId} {
      // Per-difficulty best scores: doc id = uid_difficulty
      // Public read; signed-in users write only their own uid + valid difficulty
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.difficulty in ['easy', 'normal', 'hell']
        && docId == request.auth.uid + '_' + request.resource.data.difficulty
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Legacy single-doc scores/{uid} — read-only for migration; no new writes
    }

    match /mp_rooms/{roomId} {
      // Prototype multiplayer rooms — auth required; slightly loose field checks
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && roomId.matches('[A-Z0-9]{6}');

      allow update: if request.auth != null && (
        // Host can update freely (state, dirs, status, …)
        resource.data.hostUid == request.auth.uid
        // Existing guest can update (guestDir etc.)
        || resource.data.guestUid == request.auth.uid
        // Joining: claim empty guest seat
        || (
          resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
        )
      );

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
